#!/usr/bin/with-contenv bashio

bashio::log.info "Checking directories..."

DOWNLOAD_DIR=$(bashio::config 'download_dir')

mkdir -p "${DOWNLOAD_DIR}/Incomplete"
mkdir -p "${DOWNLOAD_DIR}/Incoming"
mkdir -p "${DOWNLOAD_DIR}/.session"

rm -f "${DOWNLOAD_DIR}/.session/rtorrent.lock"

tempio \
      -conf /data/options.json \
      -template /etc/rtorrent.d/templates/rtorrent.rc.gtpl \
      -out /etc/rtorrent.d/rtorrent.rc
